// Resource management schema. Reservations and profiles follow in later phases.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ResourceStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model Resource {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  category    String
  location    String
  capacity    Int      @default(0)
  status      ResourceStatus @default(ACTIVE)
  floor       String?
  imageUrl    String?
  slug        String?  @unique
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("resources")
  @@index([status, category])
}
