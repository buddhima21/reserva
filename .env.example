# Configuration template for the future database and authentication setup.
# Copy to .env and replace placeholders locally when those features are added.
# Never commit real database passwords, connection strings, or secret API keys.

# Server-only Supabase PostgreSQL session pooler connection (port 5432).
DATABASE_URL="PASTE_YOUR_SESSION_POOLER_CONNECTION_STRING"

# Supabase Auth: project URL and public publishable key.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
